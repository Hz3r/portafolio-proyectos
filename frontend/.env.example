# URL del backend (Railway: https://${{backend.RAILWAY_PUBLIC_DOMAIN}})
API_URL=http://localhost:4000

# Lo que aparece en el encabezado del sitio
SITE_HANDLE=@tu_usuario
SITE_TAGLINE=Cosas que he construido.
# Opcional: enlace al tocar el usuario (por ejemplo tu Instagram)
SITE_LINK=

HOST=0.0.0.0
PORT=4321

# Dirección pública del sitio (sin barra final). Se usa en el sitemap, robots.txt y los enlaces canónicos.
PUBLIC_SITE_URL=

# Google Analytics 4: el ID de medición (G-XXXXXXX). Vacío = sin analítica.
GA_MEASUREMENT_ID=

# Search Console: solo el valor de content de la etiqueta de verificación de Google.
GOOGLE_SITE_VERIFICATION=
