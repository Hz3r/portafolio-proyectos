---
import type { Owner, Project } from '../lib/api'
import { githubAvatar } from '../lib/api'

interface Props {
  project: Project
  owner: Owner
}
const { project, owner } = Astro.props
const mine = project.myRole === 'AUTHOR'

// Yo voy primero si el proyecto es mío; si colaboré, primero su equipo.
const me = { name: owner.handle, url: owner.github ?? '', role: project.myRoleNote || (mine ? 'Autor' : 'Colaborador'), self: true }
const others = project.people.map((p) => ({ ...p, self: false }))
const people = mine ? [me, ...others] : [...others, me]
---

<section aria-label="Créditos">
  <p class="text-dim text-sm">
    {mine ? (others.length ? 'Proyecto propio, con colaboradores' : 'Proyecto propio') : 'Proyecto en el que colaboré'}
  </p>
  <ul class="mt-3 flex flex-wrap gap-2">
    {people.map((p) => {
      const avatar = githubAvatar(p.url)
      const Tag = p.url ? 'a' : 'span'
      return (
        <li>
          <Tag
            href={p.url || undefined}
            target={p.url ? '_blank' : undefined}
            rel={p.url ? 'noopener noreferrer' : undefined}
            class:list={[
              'bg-surface flex items-center gap-3 rounded-full border py-1.5 pr-4 pl-1.5',
              p.self ? 'border-accent/40' : 'border-line',
              p.url && 'hover:border-accent transition-colors',
            ]}
          >
            {avatar ? (
              <img src={avatar} alt="" width="32" height="32" loading="lazy" class="bg-line size-8 rounded-full" />
            ) : (
              <span class="bg-line font-pixel flex size-8 items-center justify-center rounded-full text-xs uppercase">
                {p.name.replace(/^@/, '').slice(0, 1)}
              </span>
            )}
            <span class="leading-tight">
              <span class="block text-sm font-medium">{p.name}</span>
              {p.role && <span class="text-dim block text-xs">{p.role}</span>}
            </span>
          </Tag>
        </li>
      )
    })}
  </ul>
</section>
