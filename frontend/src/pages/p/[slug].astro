---
import Gallery from '../../components/Gallery'
import { Lock } from '../../components/ProjectGrid'
import Base from '../../layouts/Base.astro'
import { pad, stillOf } from '../../lib/api'
import { getProject, getProjects } from '../../lib/server'
import { renderMarkdown } from '../../lib/markdown'

const project = await getProject(Astro.params.slug ?? '')
if (project === null) return Astro.rewrite('/404')
if (project === 'error') {
  return new Response('No se pudo cargar el proyecto. Recarga la página en unos segundos.', {
    status: 503,
    headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Retry-After': '10' },
  })
}

const { projects } = await getProjects()
const index = projects.findIndex((p) => p.id === project.id)
const prev = index > 0 ? projects[index - 1] : null
const next = index >= 0 && index < projects.length - 1 ? projects[index + 1] : null

// La portada va primero en la galería.
const coverId = project.cover?.id
const media = [...project.media].sort((a, b) => Number(b.id === coverId) - Number(a.id === coverId))
const html = project.description ? renderMarkdown(project.description) : ''
const host = project.url ? new URL(project.url).hostname.replace(/^www\./, '') : ''

Astro.response.headers.set('Cache-Control', 'public, max-age=30, s-maxage=30, stale-while-revalidate=300')
---

<Base title={project.title} description={project.summary || undefined} image={stillOf(project.cover)}>
  <nav class="flex items-center justify-between pt-6 pb-8 sm:pt-10 sm:pb-12">
    <a href="/" class="pixel text-dim hover:text-accent -ml-2 rounded-full px-2 py-3 transition-colors">
      <span aria-hidden="true">◀</span> Proyectos
    </a>
    {index >= 0 && (
      <p class="pixel text-dim">
        <span class="text-accent">{pad(index + 1)}</span> / {pad(projects.length)}
      </p>
    )}
  </nav>

  <main>
    <header class="max-w-3xl">
      <h1 class="text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-6xl">{project.title}</h1>
      {project.summary && <p class="text-dim mt-4 text-xl leading-snug text-pretty sm:text-2xl">{project.summary}</p>}
      <div class="pixel text-dim mt-6 flex flex-wrap items-center gap-x-4 gap-y-2">
        {project.year && <span class="text-ink">{project.year}</span>}
        {project.tags.map((t) => <span>{t}</span>)}
      </div>
    </header>

    {media.length > 0 && (
      <section class="mt-10 sm:mt-14" aria-label="Galería">
        <Gallery client:load media={media} title={project.title} coverId={coverId} projectId={project.id} />
      </section>
    )}

    {html && <section class="prose-project mt-12 sm:mt-16" set:html={html} />}

    <section class="mt-12 sm:mt-16">
      {project.url ? (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-accent text-bg inline-flex items-center gap-3 rounded-full py-4 pr-7 pl-6 text-lg font-medium shadow-[0_0_40px_-8px_rgb(158_255_90/0.6)] transition-transform hover:scale-[1.03] active:scale-[0.98]"
        >
          <span class="text-sm" aria-hidden="true">▶</span>
          Visitar {host}
        </a>
      ) : (
        <p class="border-line text-dim inline-flex items-center gap-3 rounded-full border py-3.5 pr-6 pl-5">
          <span class="text-accent"><Lock /></span>
          Proyecto privado, sin enlace público
        </p>
      )}
    </section>
  </main>

  {(prev || next) && (
    <nav class="border-line mt-20 grid grid-cols-2 gap-4 border-t pt-8" aria-label="Otros proyectos">
      <div>
        {prev && (
          <a href={`/p/${prev.slug}`} class="group block rounded-lg py-2">
            <span class="pixel text-dim">Anterior</span>
            <span class="group-hover:text-accent mt-2 block font-medium transition-colors">{prev.title}</span>
          </a>
        )}
      </div>
      <div class="text-right">
        {next && (
          <a href={`/p/${next.slug}`} class="group block rounded-lg py-2">
            <span class="pixel text-dim">Siguiente</span>
            <span class="group-hover:text-accent mt-2 block font-medium transition-colors">{next.title}</span>
          </a>
        )}
      </div>
    </nav>
  )}
</Base>
