---
import PortfolioPage from '../components/pages/PortfolioPage.astro'
import ProjectsPage from '../components/pages/ProjectsPage.astro'
import { getSite } from '../lib/server'

// La raíz muestra la página elegida en Ajustes; /proyectos y /portafolio existen siempre.
const { home } = await getSite()
---

{home === 'PORTFOLIO' ? <PortfolioPage /> : <ProjectsPage />}
