---
import Base from '../layouts/Base.astro'
Astro.response.status = 404
---

<Base title="No encontrado">
  <main class="flex min-h-[80dvh] flex-col items-center justify-center text-center">
    <p class="font-pixel text-accent text-4xl sm:text-6xl">Game over</p>
    <p class="text-dim mt-6 max-w-xs">Esta página no existe o el proyecto ya no está publicado.</p>
    <a
      href="/proyectos"
      class="bg-accent text-bg mt-10 rounded-full px-6 py-3 font-medium transition-transform hover:scale-[1.03] active:scale-[0.98]"
    >
      Volver a los proyectos
    </a>
  </main>
</Base>
