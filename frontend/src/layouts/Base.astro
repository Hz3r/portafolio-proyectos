---
import '@fontsource-variable/geist'
import '@fontsource-variable/geist-mono'
import '@fontsource/silkscreen/400.css'
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
import SoundToggle from '../components/SoundToggle'
import Roamers from '../components/Roamers'
import { getSite } from '../lib/server'

interface Props {
  title?: string
  description?: string
  image?: string | null
  /** Título completo, sin añadir el usuario. */
  fullTitle?: string
}

const site = await getSite()
const { title, description = site.tagline, image } = Astro.props
const fullTitle = Astro.props.fullTitle ? Astro.props.fullTitle : title ? `${title} | ${site.handle}` : `${site.handle} | Proyectos`
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#08080c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <ClientRouter />
  </head>
  <body>
    <div class="stars" aria-hidden="true"><i></i><i></i></div>
    <Roamers client:idle className="fixed inset-0 z-0 opacity-80" />
    <div class="relative z-[1] mx-auto w-full max-w-6xl px-5 pb-24 sm:px-8">
      <slot />
    </div>
    <SoundToggle client:idle transition:persist />
  </body>
</html>
