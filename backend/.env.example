# Base de datos (Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portafolio

# Secreto para firmar sesiones. Mínimo 32 caracteres: openssl rand -hex 32
JWT_SECRET=

# Usuario administrador (se crea o actualiza en cada despliegue)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# URL pública de este backend y orígenes permitidos (frontend y admin, separados por coma)
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:4321

# Bucket compatible con S3 (Railway: variables del bucket)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=portafolio
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=auto
# true solo para MinIO local
S3_FORCE_PATH_STYLE=true
# Opcional: si el bucket tiene URL pública, los archivos se sirven desde ahí
S3_PUBLIC_URL=

# Opcional: asistente de la terminal del portafolio. Con la clave, los visitantes pueden hacer
# preguntas libres y responde Claude con los datos publicados. Sin ella, la terminal usa solo sus comandos.
ANTHROPIC_API_KEY=
# Opcional: modelo del asistente (por defecto claude-opus-5-5; claude-haiku-5-5 cuesta mucho menos)
ASK_MODEL=
# Opcional: token de GitHub (sin permisos especiales) para leer el calendario de contribuciones por la API
# oficial. Sin él se lee la página pública de tu perfil.
GITHUB_TOKEN=

PORT=4000
