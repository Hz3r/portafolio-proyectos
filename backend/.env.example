# Base de datos (Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portafolio

# Secreto para firmar sesiones. Mínimo 32 caracteres: openssl rand -hex 32
JWT_SECRET=

# Usuario administrador (se crea o actualiza en cada despliegue)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# URL pública de este backend y orígenes permitidos (frontend y admin, separados por coma)
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:4321

# Bucket compatible con S3 (Railway: variables del bucket)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=portafolio
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=auto
# true solo para MinIO local
S3_FORCE_PATH_STYLE=true
# Opcional: si el bucket tiene URL pública, los archivos se sirven desde ahí
S3_PUBLIC_URL=

PORT=4000
